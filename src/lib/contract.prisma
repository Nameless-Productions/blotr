// use prisma-8

enum Role {
  OWNER
  ADMINISTRATOR
  MODERATOR
  USER
}

model User {
  id Int @id @default(autoincrement())
  robloxID String @unique
  discordID String @unique
  role Role @default(USER)
}

model CommandLog {
  id Int @id @default(autoincrement())
  robloxUserId String
  timestamp Int @unique
  command String
  userId Int?
}

model ModCall {
  id Int @id @default(autoincrement())
  callerId Int
  moderatorId String?
  timestamp Int @unique
}